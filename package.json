{
  "name": "mebel-cnc-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "3D viewers for mebel-cnc (three.js), bundled into a single HTML file",
  "license": "MIT",
  "scripts": {
    "build": "esbuild viewer/src/main.js --bundle --format=iife --global-name=MebelViewer --minify --target=es2020 --outfile=viewer/dist/viewer.bundle.js",
    "build:kitchen": "esbuild viewer/src/kitchen.js --bundle --format=iife --global-name=KitchenViewer --minify --target=es2020 --outfile=viewer/dist/kitchen.bundle.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.186.1"
  }
}
